+/// Split `text` into lines, each paired with the terminator it actually had:
+/// `"\r\n"`, `"\n"`, or `""` for a final line with no newline.
+fn split_terminated(text: &str) -> Vec<(String, &'static str)> {
+    text.split_inclusive('\n')
+        .map(|line| {
+            if let Some(body) = line.strip_suffix("\r\n") {
+                (body.to_string(), "\r\n")
+            } else if let Some(body) = line.strip_suffix('\n') {
+                (body.to_string(), "\n")
+            } else {
+                (line.to_string(), "")
+            }
+        })
+        .collect()
+}
