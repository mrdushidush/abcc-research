+/// One side of a hunk header, `-L[,N]` or `+L[,M]`: the start line and the
+/// body line count (1 when the count is omitted, as diff does).
+fn hunk_range(loc: &str, sign: char) -> Option<(usize, usize)> {
+    let mut parts = loc.strip_prefix(sign).unwrap_or(loc).split(',');
+    let start = parts.next()?.parse().ok()?;
+    let count = parts.next().map_or(Some(1), |c| c.parse().ok())?;
+    Some((start, count))
+}
