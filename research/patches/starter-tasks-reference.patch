+    /// The reason there is no measurement, when there is none.
+    ///
+    /// The partner of [`Outcome::rung`]: every outcome has a rung, and only an
+    /// unmeasured one has a [`Why`]. `None` means *this rung was measured*,
+    /// never *the reason is unknown*.
+    #[must_use]
+    pub fn why(&self) -> Option<&Why> {
+        match self {
+            Outcome::Measured(_) => None,
+            Outcome::Unmeasured { why, .. } => Some(why),
+        }
