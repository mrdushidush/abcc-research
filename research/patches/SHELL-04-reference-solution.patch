+/// Kill the child **and every process it spawned**.
+///
+/// `Child::kill` is a single-process `TerminateProcess`/`SIGKILL`. A child that
+/// is itself a launcher — `powershell`, `cmd`, `npm`, `cargo`, git's helpers —
+/// dies while its own children keep running, and those grandchildren hold the
+/// stdout/stderr write ends they inherited. The pipe then never reaches EOF
+/// and the reader threads never finish: measured on this runner, a 3 s budget
+/// returned after 60 s, the exact lifetime of the surviving grandchild.
+///
+/// The sweep uses what each platform offers without a new dependency:
+/// `taskkill /T /F /PID` walks the parent-PID tree on Windows, and on Unix the
+/// negated PID signals the process group `own_process_group` put the child in.
+/// Both are best-effort — `Child::kill` still runs underneath, and
+/// `join_reader`'s deadline is the backstop for anything that survives.
+fn kill_process_tree(child: &mut Child) {
+    let pid = child.id();
+
+    #[cfg(windows)]
+    let (program, args) = (
+        "taskkill",
+        vec![
+            "/T".to_string(),
+            "/F".to_string(),
+            "/PID".to_string(),
+            pid.to_string(),
+        ],
+    );
+    #[cfg(not(windows))]
+    let (program, args) = ("kill", vec!["-KILL".to_string(), format!("-{pid}")]);
