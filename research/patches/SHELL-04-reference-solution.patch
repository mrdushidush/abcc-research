+/// Wait up to `READER_DRAIN_GRACE` for a pipe reader to reach EOF, then return
+/// whatever it captured.
+///
+/// **The deadline is the point.** An unbounded join is correct only while the
+/// child is the sole owner of the write end; the moment a grandchild survives
+/// holding it, the join blocks for that grandchild's whole lifetime and the
+/// timeout this module exists to enforce becomes advisory. A reader abandoned
+/// at the deadline is left to exit on its own — it owns nothing but its buffer,
+/// which stays readable here because it lives outside the thread.
+fn join_reader(reader: PipeReader) -> String {
+    let _ = reader.finished.recv_timeout(READER_DRAIN_GRACE);
+    let bytes = reader
+        .captured
+        .lock()
+        .map(|held| held.clone())
+        .unwrap_or_default();
+    String::from_utf8_lossy(&bytes).into_owned()
 }
 
