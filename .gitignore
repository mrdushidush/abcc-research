target/
node_modules/
*.log
.env
scratch/

# `runs/` was a bare UNANCHORED rule, so it hid any directory named runs at any depth —
# harness/runs/ (153 files) included. Keep exactly that, then carve the exceptions out of the
# ROOT tree only. Anchoring matters: a pattern with a middle separator matches only at the root.
**/runs/
!/runs/

# The root runs/ tree is 3.8 GB across 55,577 files and stays out of git. Two exceptions,
# David 2026-08-28, closing §16's "raw results committed" clause for ~0.05% of the tree:
#   /runs/hw-probe/        the headline rows that ARE the measured peak-RAM answer (1.9 MB)
#   /runs/**/runmeta.json  the 62 manifests sweep B joins on, so the join is reproducible (103 KiB)
# The directory negation is required: git cannot re-include a file under an excluded directory.
/runs/**
!/runs/**/
!/runs/hw-probe/**
!/runs/**/runmeta.json

# FLEET probe, David 2026-08-30. The third carve-out, and the first with a rationale
# that is not "these rows ARE the answer": these are the rows a LATER session cannot
# re-derive, because the box they were measured on had Chrome open (F540).
#   /runs/fleet-p1/*.json  the 12 per-arm summaries          (226 KB with the two below)
#   /runs/fleet-p1/*.txt   the 6 *-timing.txt
#   /runs/fleet-p1/*.log   the 24 arm logs — note the ROOT `*.log` rule above also
#                          hides these, so they need their own negation, not just the
#                          /runs/** one.
# And exactly two of the twelve .jsonl traces, 4.7 MB, out of 23 MB:
#   SEQ1.jsonl / SEQ-F1.jsonl  carry the hw-probe GPU samples that separate F537's
#                              FALSE hang (75% utilisation through a 90 s "silence")
#                              from F538's true one. The other ten are routine.
!/runs/fleet-p1/*.json
!/runs/fleet-p1/*.txt
!/runs/fleet-p1/*.log
!/runs/fleet-p1/SEQ1.jsonl
!/runs/fleet-p1/SEQ-F1.jsonl

# FLEET exit measurement, 2026-08-30 (F553). Same rationale as the block above and
# smaller: these are the rows a later session cannot re-derive, because a peak is only
# comparable against its OWN session's baseline (F488, F540) and this session's unloaded
# baseline was 18.20 GiB. Four hw-probe summaries plus the two sortie transcripts, ~40 KB.
#   /runs/fleet-p3/*.json  the 4 arm summaries, headline + full per-metric stats
#   /runs/fleet-p3/*.log   the 2 sortie transcripts — the ROOT `*.log` rule hides these
#                          too, so this negation is needed as well as the /runs/** one.
# The four .jsonl traces (4 MB) stay out: nothing in them settles a question the way
# fleet-p1's SEQ1/SEQ-F1 separated a false hang from a true one.
!/runs/fleet-p3/*.json
!/runs/fleet-p3/*.log

__pycache__/
*.pyc
research/spikes/w4-logprobs/lp-rep*.jsonl
# repeat 3 lost its server mid-run; kept on disk under a name the analyzer's glob cannot
# reach, and out of git for the same reason the clean repeats are (8 MB each).
research/spikes/w4-logprobs/CONTAMINATED-*.quarantined
research/spikes/w4-logprobs/cascade-rep*.jsonl
research/spikes/w4-logprobs/probe*-rep*.jsonl
research/spikes/w4-logprobs/smoke*-rep*.jsonl

# The findings ledger is DERIVED from the markdown by research/tools/fledger.py.
# Rebuild it with `python research/tools/fledger.py build`. The AUTHORED half -
# research/findings-supersession.tsv - is committed; the index never is, because
# an index that can be rebuilt can never be the thing that loses data.
research/findings.sqlite
